@using SunCalcNet.Demo.Services

@* Map of the sky seen from above: centre is overhead, the rim is the horizon, north up and east right *@
<svg class="compass" viewBox="-178 -178 356 356" role="img"
     aria-label="@($"Sun at {Position.SunAltitude:F0}° altitude, {Position.SunAzimuth:F0}° azimuth; moon at {Position.MoonAltitude:F0}° altitude, {Position.MoonAzimuth:F0}° azimuth")">
    <circle r="@R" class="dome" />
    @foreach (var alt in new[] { 30, 60 })
    {
        <g>
            <circle r="@F(Radius(alt))" class="ring" />
            <text x="4" y="@F(-Radius(alt) - 3)" class="ring-label">@(alt)°</text>
        </g>
    }
    @for (var az = 0; az < 360; az += 30)
    {
        var (x, y) = Point(az, 0);
        <line x1="0" y1="0" x2="@F(x)" y2="@F(y)" class="spoke" />
    }
    @foreach (var (label, az) in new[] { ("N", 0), ("E", 90), ("S", 180), ("W", 270) })
    {
        var (x, y) = Point(az, -14);
        <g><text x="@F(x)" y="@F(y + 5)" class="cardinal">@label</text></g>
    }

    @foreach (var (path, kind) in new[] { (Segments(s => (s.MoonAltitude, s.MoonAzimuth)), "moon"), (Segments(s => (s.SunAltitude, s.SunAzimuth)), "sun") })
    {
        foreach (var segment in path)
        {
            <polyline points="@segment.Points" class="@($"{kind}-path")" />

            @* a path cut by the day boundary (body up at midnight): mark the end so the gap reads as midnight, not a glitch *@
            @* 00:00 below its dot and 24:00 above, so the two labels never collide when the ends are close *@
            @foreach (var (end, label, dy) in new[] { (segment.AtMidnightStart, "00:00", 14.0), (segment.AtMidnightEnd, "24:00", -7.0) })
            {
                if (end is { } e)
                {
                    <g class="path-end @kind">
                        <circle cx="@F(e.X)" cy="@F(e.Y)" r="3" />
                        <text x="@F(e.X)" y="@F(e.Y + dy)">@label</text>
                    </g>
                }
            }
        }
    }

    @if (Position.MoonAltitude > 0)
    {
        var (mx, my) = Point(Position.MoonAzimuth, Position.MoonAltitude);
        <circle cx="@F(mx)" cy="@F(my)" r="8" class="moon-dot" />
    }
    @if (Position.SunAltitude > 0)
    {
        var (sx, sy) = Point(Position.SunAzimuth, Position.SunAltitude);
        <circle cx="@F(sx)" cy="@F(sy)" r="9" class="sun-dot" />
    }
</svg>

@code {
    private const double R = 140;

    [Parameter, EditorRequired] public AlmanacDay Day { get; set; } = default!;
    [Parameter, EditorRequired] public SkyPosition Position { get; set; } = default!;

    private static double Radius(double altitude) => R * (90 - altitude) / 90;

    private static (double X, double Y) Point(double azimuth, double altitude)
    {
        var r = Radius(altitude);
        var a = azimuth * Math.PI / 180;
        return (r * Math.Sin(a), -r * Math.Cos(a));
    }

    private sealed record Segment(string Points, (double X, double Y)? AtMidnightStart, (double X, double Y)? AtMidnightEnd);

    // the day's path split into the stretches above the horizon, so no line jumps across a set/rise gap;
    // a stretch that touches the start or end of the day is up at midnight, and remembers that end
    private IEnumerable<Segment> Segments(Func<SkySample, (double Alt, double Az)> pick)
    {
        var samples = Day.Samples.Select(pick).ToList();
        var points = new List<(double X, double Y)>();
        var startsAtMidnight = false;

        for (var i = 0; i < samples.Count; i++)
        {
            var (alt, az) = samples[i];
            if (alt >= 0)
            {
                if (points.Count == 0)
                {
                    startsAtMidnight = i == 0;
                }

                points.Add(Point(az, alt));
                continue;
            }

            if (points.Count > 1)
            {
                yield return Build(points, startsAtMidnight, endsAtMidnight: false);
            }

            points.Clear();
        }

        if (points.Count > 1)
        {
            yield return Build(points, startsAtMidnight, endsAtMidnight: true);
        }
    }

    private static Segment Build(List<(double X, double Y)> points, bool startsAtMidnight, bool endsAtMidnight) =>
        new(string.Join(" ", points.Select(p => $"{F(p.X)},{F(p.Y)}")),
            startsAtMidnight ? points[0] : null,
            endsAtMidnight ? points[^1] : null);

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
